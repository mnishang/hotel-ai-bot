# ============================================================================
# AI Assistant — server-side environment variables
# Copy this file to `.env.local` and fill in your provider key.
# Never expose these values to the browser or commit `.env.local`.
# ============================================================================

# Required: API key for your AI provider (OpenAI or any OpenAI-compatible API).
AI_API_KEY=your_api_key_here

# Optional: base URL of the OpenAI-compatible API.
AI_BASE_URL=https://api.openai.com/v1

# Optional: model name to use for replies.
AI_MODEL=gpt-4o-mini
